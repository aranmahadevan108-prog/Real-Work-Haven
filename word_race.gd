var allowed: Dictionary = {}
var keys: Dictionary = {}
var key_ranks: Dictionary = {}
var tiles: Array[Label] = []
var secret := ""
var attempts := 0
var seconds_left := 0
var playing := false

var clock_label := Label.new()
var status := Label.new()
var input := LineEdit.new()
var replay := Button.new()
var timer := Timer.new()


func _ready() -> void:
	for word in ANSWERS:
		allowed[word] = true
	for word in EXTRA_WORDS.replace("\n", " ").split(" ", false):
		allowed[word] = true

	var center := CenterContainer.new()
	add_child(center)
	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)

	var layout := VBoxContainer.new()
	layout.custom_minimum_size.x = 320
	layout.add_theme_constant_override("separation", 8)
	center.add_child(layout)

	var title := Label.new()
	title.text = "Word Race"
	title.add_theme_font_size_override("font_size", 30)
	for label in [title, clock_label, status]:
		label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		layout.add_child(label)

	var grid_center := CenterContainer.new()
	layout.add_child(grid_center)
	var grid := GridContainer.new()
	grid.columns = 5
	grid_center.add_child(grid)
	for i in range(MAX_GUESSES * 5):
		tiles.append(_make_tile(grid, "", Vector2(44, 38), 22))

	var legend := Label.new()
	legend.text = "Green = exact · Yellow = wrong spot · Gray = absent"
	legend.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	legend.add_theme_font_size_override("font_size", 13)
	layout.add_child(legend)

	input.placeholder_text = "Type a word and press Enter"
	input.text_submitted.connect(_submit)
	layout.add_child(input)

	for row_letters in KEY_ROWS:
		var row := HBoxContainer.new()
		row.alignment = BoxContainer.ALIGNMENT_CENTER
		layout.add_child(row)
		for letter in row_letters:
			keys[letter] = _make_tile(row, letter, Vector2(27, 30), 16)

	replay.text = "Play Again"
	replay.pressed.connect(_start_round)
	layout.add_child(replay)

	add_child(timer)
	timer.wait_time = 1.0
	timer.timeout.connect(_tick)
	_start_round()


func _make_tile(parent: Control, text: String, size: Vector2, font_size: int) -> Label:
	var tile := PanelContainer.new()
	tile.custom_minimum_size = size
	parent.add_child(tile)

	var label := Label.new()
	label.text = text
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.add_theme_font_size_override("font_size", font_size)
	label.add_theme_color_override("font_color", Color.WHITE)
	tile.add_child(label)
	return label


func _paint(label: Label, rank: int) -> void:
	var tile := label.get_parent() as PanelContainer
	var style := StyleBoxFlat.new()
	style.bg_color = COLORS[rank]
	style.set_corner_radius_all(5)
	tile.add_theme_stylebox_override("panel", style)
	tile.tooltip_text = HINTS[rank] if not label.text.is_empty() else ""


func _start_round() -> void:
	var choices: Array = ANSWERS.duplicate()
	choices.erase(secret)
	secret = choices.pick_random()
	attempts = 0
	seconds_left = ROUND_SECONDS
	playing = true

	for tile in tiles:
		tile.text = ""
		_paint(tile, 0)
	key_ranks.clear()
	for key in keys.values():
		_paint(key, 0)

	status.text = "Guess the word in six tries."
	input.clear()
	input.show()
	input.grab_focus()
	replay.hide()
	_update_clock()
	timer.start()


func _submit(raw_guess: String) -> void:
	if not playing:
		return
	var guess := raw_guess.strip_edges().to_upper()
	if guess.length() != 5:
		status.text = "Enter exactly five letters."
		return
	if not allowed.has(guess):
		status.text = "That word isn’t in the word bank."
		input.select_all()
		return

	var ranks := _feedback(guess)
	for i in range(5):
		var letter := guess[i]
		var tile := tiles[attempts * 5 + i]
		tile.text = letter
		_paint(tile, ranks[i])

		# Keep the best hint even if the same letter later gets gray.
		var best := maxi(ranks[i], int(key_ranks.get(letter, 0)))
		key_ranks[letter] = best
		_paint(keys[letter], best)

	attempts += 1
	input.clear()
	if guess == secret:
		_finish("Solved in %d tries!" % attempts, 100 - (attempts - 1) * 10)
	elif attempts == MAX_GUESSES:
		_finish("The word was %s." % secret, 0)
	else:
		status.text = "%d guesses left." % (MAX_GUESSES - attempts)


func _feedback(guess: String) -> Array[int]:
	var ranks: Array[int] = [1, 1, 1, 1, 1]
	var remaining: Dictionary = {}
	for i in range(5):
		if guess[i] == secret[i]:
			ranks[i] = 3
		else:
			remaining[secret[i]] = int(remaining.get(secret[i], 0)) + 1
	for i in range(5):
		var letter := guess[i]
		var copies := int(remaining.get(letter, 0))
		if ranks[i] != 3 and copies > 0:
			ranks[i] = 2
			remaining[letter] = copies - 1
	return ranks


func _tick() -> void:
	seconds_left -= 1
	_update_clock()
	if seconds_left == 0:
		_finish("Time’s up! The word was %s." % secret, 0)


func _update_clock() -> void:
	clock_label.text = "Time left  %d:%02d" % [
		floori(seconds_left / 60.0), seconds_left % 60
	]


func _finish(message: String, points: int) -> void:
	playing = false
	timer.stop()
	status.text = "%s  Score: %d" % [message, points]
	input.hide()
	replay.show()
	replay.grab_focus()
	round_finished.emit(points)
